---
import { Image } from 'astro:assets';
import Icon from '@components/ui/Icon.astro';
import { site, contact, footerNav, socials } from '@data/site';
import logo from '@assets/images/TFM-Logo-Outline.png';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-white">
  <div class="container-tfm">
    <div
      class="grid gap-x-10 gap-y-12 py-16 md:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1fr_1.45fr] lg:gap-x-12 lg:py-20"
    >
      {/* Identity. The wordmark carries its own stripe stack — it needs no
          extra mark, just room and one plain sentence about the company. */}
      <div>
        <Image
          src={logo}
          alt={`${site.name} logo`}
          width={440}
          widths={[220, 440]}
          sizes="176px"
          class="h-auto w-44 max-w-full"
          loading="eager"
          decoding="async"
        />
        <p class="mt-6 max-w-xs text-[0.9375rem] leading-relaxed">
          U.S. foam &amp; mattress manufacturer — private label programs,
          warehousing, and drop shipping from Lansdale, PA.
        </p>
      </div>

      <nav aria-labelledby="footer-quick">
        <h2
          id="footer-quick"
          class="font-display text-base font-semibold uppercase tracking-[0.08em] text-ink"
        >
          Quick Links
        </h2>
        <ul class="mt-6 space-y-4">
          {
            footerNav.quickLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group inline-flex items-center gap-2 text-[1.0625rem] transition-colors hover:text-brand"
                >
                  <span
                    class="h-px w-0 bg-brand transition-all duration-200 group-hover:w-3.5"
                    aria-hidden="true"
                  />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-pl">
        <h2
          id="footer-pl"
          class="font-display text-base font-semibold uppercase tracking-[0.08em] text-ink"
        >
          Private Label
        </h2>
        <ul class="mt-6 space-y-4">
          {
            footerNav.privateLabel.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group inline-flex items-center gap-2 text-[1.0625rem] transition-colors hover:text-brand"
                >
                  <span
                    class="h-px w-0 bg-brand transition-all duration-200 group-hover:w-3.5"
                    aria-hidden="true"
                  />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section
        aria-labelledby="footer-contact"
        class="rounded-(--radius-card) bg-navy p-8 text-white/90"
      >
        <h2
          id="footer-contact"
          class="font-display text-base font-semibold uppercase tracking-[0.08em] text-white"
        >
          Get in touch
        </h2>
        <ul class="mt-6 space-y-5">
          <li>
            <a
              href={contact.phoneHref}
              class="group flex items-center gap-3.5 transition-colors hover:text-white"
            >
              <span
                class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors group-hover:bg-brand"
              >
                <Icon name="phone" size={17} />
              </span>
              <span class="text-[1.0625rem] font-medium">{contact.phone}</span>
            </a>
          </li>
          <li>
            <a
              href={contact.emailHref}
              class="group flex items-center gap-3.5 break-all transition-colors hover:text-white"
            >
              <span
                class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors group-hover:bg-brand"
              >
                <Icon name="mail" size={17} />
              </span>
              <span class="text-[1.0625rem]">{contact.email}</span>
            </a>
          </li>
          <li class="flex items-center gap-3.5">
            <span
              class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-white"
            >
              <Icon name="pin" size={17} />
            </span>
            <address class="text-[1.0625rem] not-italic leading-snug">
              {contact.address.full}
            </address>
          </li>
        </ul>

        {
          socials.length > 0 && (
            <ul class="mt-7 flex flex-wrap gap-2">
              {socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    class="inline-flex size-10 items-center justify-center rounded-full bg-brand text-white transition-colors hover:bg-brand-dark"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    <Icon name={social.icon} size={18} />
                    <span class="sr-only">{social.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </div>

  <div class="bg-ink py-5">
    <div class="container-tfm">
      <p class="text-center text-sm tracking-wide text-white/60">
        &copy; {year} {site.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
